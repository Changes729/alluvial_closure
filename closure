#!/bin/sh
set -u

# 按调用名识别模式：*-dryrun（如 closure-dryrun，建符号链接即可）为预演模式
case ${0##*/} in
    *-dryrun) DRYRUN=1 ;;
    *)        DRYRUN='' ;;
esac

usage() {
    cat >&2 <<'EOF'
usage: closure entry [args...]

  entry   a dot-prefixed config file or config directory (e.g. .echo);
          a directory uses its inner same-named file as the config and
          runs the app inside a FUSE overlay (upper: sibling without
          the leading dot; requires alluvial_fuse)
  args    extra arguments appended verbatim after the assembled ones

Called as *-dryrun (e.g. via a symlink closure-dryrun), it only prints
the assembled command instead of running it.

examples:
  $ cat .echo
  hello world
  $ closure .echo
  hello world
EOF
}

# ---- 拼装 ----------------------------------------------------------------
# 配置内容不做引号/变量/通配符展开（不 eval），始终按字面拆词。

ARGS=''   # 拼装结果：一行一个参数

NL='
'
TAB='	'
WS=" $TAB$NL"   # 拆词用分隔符：空格、制表符、换行

# add_file FILE —— FILE 内容按空白拆词，逐个追加进 $ARGS
add_file() {
    [ -f "$1" ] && [ -r "$1" ] || return 0
    case $- in
        *f*) wf=1 ;;
        *) wf=0 ;;
    esac

    set -f                      # 拆词时关闭通配符展开
    old=$IFS
    IFS=$WS
    for word in $(cat "$1"); do
        ARGS="$ARGS$word
"
    done
    IFS=$old
    [ "$wf" -eq 0 ] && set +f
    return 0
}

# add_entry ENTRY —— 配置条目（文件或目录）拼装进 $ARGS
# 目录条目（如 .echo/）：只取其中同名配置文件 .echo/.echo，不拼接目录内其他文件；
# 缺失时按空配置处理（应用仍被调用，仅拼装参数为空）
add_entry() {
    if [ -d "$1" ]; then
        d=${1%/}                    # 去掉尾部斜杠：.echo/ → .echo
        add_file "$d/$d"
    else
        add_file "$1"
    fi
    return 0
}

# _mounted DIR —— 挂载点就绪：挂载表可见且视图可访问
_mounted() {
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$1" 2>/dev/null && ls "$1" >/dev/null 2>&1
    else
        ls "$1" >/dev/null 2>&1
    fi
}

# _unmount DIR —— 卸载兑底：优雅退出后仍挂载则 lazy 强制卸载
_unmount() {
    if command -v mountpoint >/dev/null 2>&1; then
        mountpoint -q "$1" 2>/dev/null || return 0
    fi
    command -v fusermount3 >/dev/null 2>&1 && fusermount3 -uz "$1" >/dev/null 2>&1
    return 0
}

# run_one ENTRY [args] —— 对一个条目完成闭包调用
# 找不到应用时什么都不做并返回 0（规则 2，dryrun 下同样静默）
# 目录条目：FUSE overlay 运行——upper 为同级去点目录（.echo/ → echo/），
# work 目录建在 tmp；应用在挂载点（.echo）内运行，
# 输入读 lower（目录原内容），写入经 upper 落在同级目录；结束自动卸载，
# 同级目录为空（应用无输出）时一并删除
run_one() {
    _e=$1; shift
    _e=${_e%/}                  # 容忍尾部斜杠：.echo/ → .echo
    _app=${_e#.}
    [ -n "$_app" ] || return 0
    command -v "$_app" >/dev/null 2>&1 || return 0
    ARGS=''
    add_entry "$_e"
    old=$IFS
    IFS=$WS
    set -- $ARGS "$@"           # 拼装参数在前，额外参数在后
    IFS=$old
    if [ -n "$DRYRUN" ]; then
        _c=$_app                # 预演：打印完整命令行，不运行
        for _a in "$@"; do
            _c="$_c $_a"
        done
        printf '%s\n' "$_c"
    elif [ -d "$_e" ]; then
        command -v alluvial_fuse >/dev/null 2>&1 || {
            echo "closure: 目录条目需要 alluvial_fuse" >&2
            exit 1
        }
        _u=${_e#.}              # upper：同级去点目录 .echo → echo
        mkdir -p "$_u" || exit 1
        _w=$(mktemp -d) || exit 1
        alluvial_fuse --mount="$_e" --upperdir="$_u" --workdir="$_w" \
            </dev/null >/dev/null 2>&1 &
        _pid=$!
        _i=0
        while [ $_i -lt 50 ]; do         # 等待挂载就绪（≤5s）
            if _mounted "$_e"; then break; fi
            _i=$((_i + 1))
            sleep 0.1
        done
        if ! _mounted "$_e"; then
            echo "closure: FUSE 挂载失败：$_e" >&2
            kill -KILL "$_pid" 2>/dev/null
            wait "$_pid" 2>/dev/null
            rmdir "$_w" 2>/dev/null
            exit 1
        fi
        ( cd "./$_e" && "$_app" "$@" )  # 在挂载点内运行；子壳返回即回到上级
        _rc=$?
        kill -TERM "$_pid" 2>/dev/null        # 优雅卸载（守护进程自行 fuse 退出）
        _i=0
        while kill -0 "$_pid" 2>/dev/null && [ $_i -lt 50 ]; do
            _i=$((_i + 1))
            sleep 0.1
        done
        kill -0 "$_pid" 2>/dev/null && kill -KILL "$_pid" 2>/dev/null
        wait "$_pid" 2>/dev/null
        _unmount "$_e"
        rmdir "$_w" 2>/dev/null
        rmdir "$_u" 2>/dev/null               # 同级目录为空才删得掉（应用无输出时清理）
        exit "$_rc"
    else
        "$_app" "$@"
    fi
}

main() {
    if [ $# -eq 0 ]; then
        usage
        exit 2
    fi

    case $1 in
        -h|--help) usage; exit 0 ;;
        .*) ;;
        *) echo "closure: 条目必须以 . 开头：$1" >&2; exit 2 ;;
    esac
    if [ ! -e "$1" ] && [ ! -L "$1" ]; then
        echo "closure: 条目不存在：$1" >&2
        exit 2
    fi
    run_one "$@"
    exit $?
}

main "$@"
